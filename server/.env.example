# ============================================================
# E-Cell UIET KUK — Backend Server Environment Configuration
# ============================================================

# Network & Server Port
PORT=5000
NODE_ENV=production

# Cross-Origin Resource Sharing (Comma-separated)
CORS_ORIGIN=https://ecell.uietkuk.ac.in,http://localhost:5174,http://localhost:8080

# Cloudflare Turnstile Bot Attestation (Optional in development)
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Google Cloud & Firebase Firestore Configuration
FIREBASE_PROJECT_ID=event-registration-page-2b9df
# Stringified JSON service account key (Optional: fallback to local memory store)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Transactional Email Engine (Brevo / Sendinblue)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=ecell@uietkuk.ac.in
BREVO_SENDER_NAME=E-Cell UIET KUK

# Google Sheets Master Ledger Integration
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
